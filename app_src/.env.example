# AI 供应商配置
# 可选值: platform (默认, 使用平台内置AI) / deepseek / dashscope / ark
AI_PROVIDER=platform

# 自有大模型 API Key（AI_PROVIDER 不为 platform 时必填）
AI_API_KEY=

# 自有大模型 API 地址（可选，不填使用各供应商默认地址）
# DeepSeek: https://api.deepseek.com
# 通义千问: https://dashscope.aliyuncs.com/compatible-mode/v1
# 火山方舟: https://ark.cn-beijing.volces.com/api/v3
AI_BASE_URL=

# 模型名称（可选，不填使用各供应商默认模型）
# DeepSeek: deepseek-chat
# 通义千问: qwen-plus
# 火山方舟: doubao-1-5-pro-32k-250115
AI_MODEL=
